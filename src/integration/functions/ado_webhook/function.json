{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post"],
      "route": "ado_webhook"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    },
    {
      "type": "serviceBus",
      "direction": "out",
      "name": "parent_msg_out",
      "queueName": "%ADO_PARENT_EVENTS_QUEUE%",
      "connection": "SERVICE_BUS_CONNECTION_STRING"
    },
    {
      "type": "serviceBus",
      "direction": "out",
      "name": "child_msg_out",
      "queueName": "%ADO_CHILD_EVENTS_QUEUE%",
      "connection": "SERVICE_BUS_CONNECTION_STRING"
    }
  ]
}

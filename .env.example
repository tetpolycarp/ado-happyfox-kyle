# Supplemental env vars for local development
# Copy to .env and fill in values — never commit .env

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=<your-service-bus-connection-string>
ADO_PARENT_EVENTS_QUEUE=ado-parent-events
ADO_CHILD_EVENTS_QUEUE=ado-child-events

# Azure DevOps
ADO_ORGANIZATION=your-org
ADO_PROJECT=your-project
ADO_PAT=<base64-encoded-pat>
ADO_WEBHOOK_SECRET=<hmac-shared-secret>

# HappyFox
HAPPYFOX_API_URL=https://yoursubdomain.happyfox.com/api/1.1/json
HAPPYFOX_API_KEY=<happyfox-api-key>
HAPPYFOX_AUTH_CODE=<happyfox-auth-code>
HAPPYFOX_WEBHOOK_SECRET=

# Runtime
LOG_LEVEL=DEBUG
ENVIRONMENT=development
